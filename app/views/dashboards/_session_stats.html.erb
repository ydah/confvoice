<div id="session_stats_<%= session.id %>" class="rounded-lg border border-zinc-200 dark:border-zinc-800/80 bg-white dark:bg-zinc-900/70 p-4">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h3 class="font-semibold text-zinc-950 dark:text-zinc-50"><%= session.title %></h3>
      <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400"><%= session.speaker_name %></p>
    </div>
    <span class="rounded-full bg-zinc-100 dark:bg-zinc-800 px-3 py-1 text-sm font-semibold text-zinc-700 dark:text-zinc-300"><%= session.feedbacks_count %> 件</span>
  </div>
  <div class="mt-4 flex items-center justify-between text-sm">
    <span class="text-zinc-600 dark:text-zinc-400">平均評価</span>
    <span class="font-semibold text-zinc-950 dark:text-zinc-50"><%= session.average_rating || "なし" %></span>
  </div>
  <div class="mt-3 flex flex-wrap gap-2">
    <% reaction_options.each do |kind, emoji| %>
      <span class="rounded-full bg-zinc-100 dark:bg-zinc-800 px-2 py-1 text-xs font-semibold text-zinc-700 dark:text-zinc-300"><%= emoji %> <%= reaction_count(session, kind) %></span>
    <% end %>
  </div>
</div>
