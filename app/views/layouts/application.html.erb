<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || t("app.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Confvoice">
    <meta name="mobile-web-app-capable" content="yes">
    <%= render "shared/social_meta",
          title: content_for?(:og_title) ? content_for(:og_title) : t("app.name"),
          description: content_for?(:og_description) ? content_for(:og_description) : t("pages.home.lead"),
          url: request.original_url,
          image_url: default_og_image_url,
          image_type: ApplicationHelper::DEFAULT_OG_IMAGE_TYPE,
          image_alt: default_og_image_alt %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%= favicon_link_tag "/favicon.ico" %>
    <%= tag.link rel: "apple-touch-icon", href: "/logo.png" %>

    <%= render "shared/theme_boot" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "https://www.gstatic.com/charts/loader.js" %>
    <%= javascript_include_tag "chartkick" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-zinc-50 text-zinc-950 antialiased dark:bg-zinc-950 dark:text-zinc-50">
    <%= render "shared/site_header" %>

    <main class="mx-auto w-full max-w-6xl px-4 py-8">
      <% flash.each do |type, message| %>
        <% tone = type.to_s == "alert" ? "border-red-200 dark:border-red-500/40 bg-red-50 dark:bg-red-500/10 text-red-700 dark:text-red-200" : "border-emerald-200 dark:border-emerald-500/40 bg-emerald-50 dark:bg-emerald-400/10 text-emerald-700 dark:text-emerald-200" %>
        <div class="<%= tone %> mb-6 rounded-md border px-4 py-3 text-sm">
          <%= message %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
