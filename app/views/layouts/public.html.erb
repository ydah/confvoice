<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || t("app.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Confvoice">
    <meta name="mobile-web-app-capable" content="yes">
    <% if @conference.present? %>
      <% og_title = content_for?(:og_title) ? content_for(:og_title) : @conference.name %>
      <% og_description = content_for?(:og_description) ? content_for(:og_description) : conference_og_description(@conference) %>
      <% og_image_url = conference_og_image_url(@conference) %>
      <%= tag.meta name: "description", content: og_description %>
      <%= tag.meta property: "og:site_name", content: t("app.name") %>
      <%= tag.meta property: "og:type", content: "website" %>
      <%= tag.meta property: "og:title", content: og_title %>
      <%= tag.meta property: "og:description", content: og_description %>
      <%= tag.meta property: "og:url", content: request.original_url %>
      <%= tag.meta name: "twitter:card", content: og_image_url.present? ? "summary_large_image" : "summary" %>
      <%= tag.meta name: "twitter:title", content: og_title %>
      <%= tag.meta name: "twitter:description", content: og_description %>
      <% if og_image_url.present? %>
        <%= tag.meta property: "og:image", content: og_image_url %>
        <%= tag.meta property: "og:image:secure_url", content: og_image_url %>
        <%= tag.meta property: "og:image:type", content: @conference.ogp_image.blob.content_type %>
        <%= tag.meta property: "og:image:alt", content: conference_og_image_alt(@conference) %>
        <%= tag.meta name: "twitter:image", content: og_image_url %>
      <% end %>
    <% end %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= render "shared/theme_boot" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-screen flex-col bg-zinc-50 text-zinc-950 antialiased dark:bg-zinc-950 dark:text-zinc-50">
    <%= render "shared/site_header", public_context: true, conference: @conference %>

    <% public_container_class = content_for?(:public_container_class) ? content_for(:public_container_class) : "max-w-xl sm:justify-center" %>
    <main class="mx-auto flex w-full flex-1 flex-col px-4 py-6 sm:py-10 <%= public_container_class %>">
      <% flash.each do |type, message| %>
        <% tone = type.to_s == "alert" ? "border-red-200 dark:border-red-500/40 bg-red-50 dark:bg-red-500/10 text-red-700 dark:text-red-200" : "border-emerald-200 dark:border-emerald-500/40 bg-emerald-50 dark:bg-emerald-400/10 text-emerald-700 dark:text-emerald-200" %>
        <div class="<%= tone %> mb-4 rounded-md border px-4 py-3 text-sm">
          <%= message %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
