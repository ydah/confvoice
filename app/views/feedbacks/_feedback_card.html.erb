<% moderation = local_assigns.fetch(:moderation, false) %>

<article id="<%= dom_id(feedback) %>" class="rounded-lg border border-zinc-200 dark:border-zinc-800/80 bg-white dark:bg-zinc-900/70 p-4 shadow-[inset_0_1px_0_rgba(255,255,255,0.03)]">
  <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-semibold text-zinc-950 dark:text-zinc-50"><%= feedback.session.title %></p>
      <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400"><%= feedback.respondent_name.presence || "名前未入力" %> / <%= short_datetime(feedback.created_at) %></p>
    </div>
    <% if feedback.rating.present? %>
      <div class="text-lg" aria-label="評価 <%= feedback.rating %>">
        <%= rating_stars(feedback.rating) %>
      </div>
    <% end %>
  </div>
  <p class="mt-3 whitespace-pre-line text-sm leading-6 text-zinc-700 dark:text-zinc-300"><%= sanitize(feedback.body) %></p>

  <% if moderation %>
    <div class="mt-4 flex flex-col gap-3 border-t border-zinc-200 dark:border-zinc-800 pt-4 sm:flex-row sm:items-center sm:justify-between">
      <% if feedback.speaker_visible? %>
        <span class="inline-flex w-fit rounded-full border border-emerald-200 dark:border-emerald-400/30 bg-emerald-50 dark:bg-emerald-400/10 px-3 py-1 text-xs font-semibold text-emerald-700 dark:text-emerald-200">登壇者に共有中</span>
        <%= button_to "共有を解除", conference_session_feedback_speaker_visibility_path(feedback.session.conference, feedback.session, feedback), method: :delete, class: "inline-flex min-h-10 cursor-pointer items-center justify-center rounded-md border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-3 py-2 text-sm font-semibold text-zinc-900 dark:text-zinc-100 transition-colors hover:bg-zinc-100 dark:hover:bg-zinc-800" %>
      <% else %>
        <span class="inline-flex w-fit rounded-full border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-950/70 px-3 py-1 text-xs font-semibold text-zinc-600 dark:text-zinc-400">主催者のみ</span>
        <%= button_to "登壇者に共有", conference_session_feedback_speaker_visibility_path(feedback.session.conference, feedback.session, feedback), method: :patch, class: "inline-flex min-h-10 cursor-pointer items-center justify-center rounded-md bg-emerald-400 px-3 py-2 text-sm font-semibold text-zinc-950 transition-colors hover:bg-emerald-300 focus:outline-none focus:ring-2 focus:ring-emerald-300 focus:ring-offset-2 focus:ring-offset-white dark:focus:ring-offset-zinc-950" %>
      <% end %>
    </div>
  <% end %>
</article>
