<% content_for :public_container_class, "max-w-4xl" %>
<% content_for :title, @conference.name %>
<% content_for :og_title, @conference.name %>
<% content_for :og_description, conference_og_description(@conference) %>

<div class="space-y-7">
  <section class="overflow-hidden rounded-lg border border-zinc-200 dark:border-zinc-800/80 bg-white dark:bg-zinc-900/70 shadow-[inset_0_1px_0_rgba(255,255,255,0.04)]">
    <% if @conference.ogp_image.attached? %>
      <%= image_tag @conference.ogp_image, alt: conference_og_image_alt(@conference), loading: "eager", class: "aspect-[1200/630] w-full object-cover" %>
    <% end %>

    <div class="p-5 sm:p-6">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <p class="inline-flex rounded-full border border-emerald-200 dark:border-emerald-400/20 bg-emerald-50 dark:bg-emerald-400/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-emerald-700 dark:text-emerald-200"><%= t("public_conferences.eyebrow") %></p>
          <h1 class="mt-4 text-3xl font-semibold tracking-normal text-zinc-950 dark:text-zinc-50 sm:text-4xl"><%= @conference.name %></h1>
        </div>
        <p class="rounded-md border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950/70 px-3 py-2 text-sm font-medium text-zinc-700 dark:text-zinc-300">
          <%= @sessions.size %> talks
        </p>
      </div>
      <p class="mt-4 text-base leading-7 text-zinc-600 dark:text-zinc-400">
        <%= conference_location_and_date(@conference) %>
      </p>
      <% if @conference.description.present? %>
        <p class="mt-4 max-w-3xl whitespace-pre-line text-base leading-7 text-zinc-700 dark:text-zinc-300"><%= @conference.description %></p>
      <% end %>
    </div>
  </section>

  <section class="space-y-4">
    <h2 class="text-xl font-semibold text-zinc-950 dark:text-zinc-50"><%= t("public_conferences.sessions_title") %></h2>

    <% if @sessions.any? %>
      <div class="space-y-6">
        <% session_date_groups(@sessions).each do |date, sessions| %>
          <section class="space-y-3">
            <h3 class="text-base font-semibold text-zinc-950 dark:text-zinc-50"><%= l(date) %></h3>

            <div class="space-y-3">
              <% sessions.each do |session| %>
                <article class="rounded-lg border border-zinc-200 dark:border-zinc-800/80 bg-white dark:bg-zinc-900/70 p-5 transition-colors hover:border-zinc-300 dark:hover:border-zinc-700">
                  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                    <div class="min-w-0 space-y-2">
                      <p class="inline-flex rounded-md bg-zinc-50 dark:bg-zinc-950/70 px-2.5 py-1 text-xs font-medium text-zinc-700 dark:text-zinc-300"><%= session_time_and_room(session) %></p>
                      <h4 class="text-lg font-semibold text-zinc-950 dark:text-zinc-50"><%= session.title %></h4>
                      <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400"><%= session.speaker_name %></p>
                      <% if session.description.present? %>
                        <p class="mt-3 line-clamp-3 text-sm leading-6 text-zinc-600 dark:text-zinc-400"><%= session.description %></p>
                      <% end %>
                    </div>

                    <div class="shrink-0">
                      <% if session.feedback_open? %>
                        <%= link_to t("public_conferences.send_feedback"), public_feedback_path(@conference, session), class: "inline-flex min-h-11 w-full cursor-pointer items-center justify-center rounded-md bg-emerald-400 px-4 py-2 text-sm font-semibold text-zinc-950 transition-colors hover:bg-emerald-300 focus:outline-none focus:ring-2 focus:ring-emerald-300 focus:ring-offset-2 focus:ring-offset-white dark:focus:ring-offset-zinc-950 sm:w-auto" %>
                      <% else %>
                        <span class="inline-flex min-h-11 w-full items-center justify-center rounded-md border border-zinc-300 dark:border-zinc-700 bg-zinc-100 dark:bg-zinc-800 px-4 py-2 text-sm font-semibold text-zinc-600 dark:text-zinc-400 sm:w-auto"><%= t("public_conferences.closed") %></span>
                      <% end %>
                    </div>
                  </div>
                </article>
              <% end %>
            </div>
          </section>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-lg border border-dashed border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900/70 p-8 text-center text-zinc-600 dark:text-zinc-400">
        <%= t("public_conferences.empty") %>
      </div>
    <% end %>
  </section>
</div>
