<% public_context = local_assigns.fetch(:public_context, false) %>
<% conference = local_assigns[:conference] %>
<% brand_path = public_context && conference ? public_conference_path(conference) : root_path %>
<% nav_link_class = "inline-flex min-h-11 items-center rounded-md px-2 py-2 text-zinc-700 transition-colors hover:bg-zinc-100 hover:text-zinc-950 dark:text-zinc-300 dark:hover:bg-zinc-900 dark:hover:text-zinc-50" %>

<header class="sticky top-0 z-20 border-b border-zinc-200 bg-white/85 backdrop-blur-md dark:border-zinc-800/80 dark:bg-zinc-950/85">
  <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex min-w-0 items-center gap-4">
      <%= link_to brand_path, class: "inline-flex shrink-0 items-center gap-2 text-lg font-bold tracking-normal text-zinc-950 dark:text-zinc-50" do %>
        <%= image_tag "/logo.png", alt: "", width: 32, height: 32, class: "h-8 w-8 shrink-0 object-contain" %>
        <span><%= t("app.name") %></span>
      <% end %>

      <% if public_context && conference %>
        <span class="hidden h-5 w-px bg-zinc-200 dark:bg-zinc-800 sm:block"></span>
        <%= link_to conference.name, public_conference_path(conference), class: "hidden min-w-0 truncate text-sm font-medium text-zinc-600 transition-colors hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-zinc-50 sm:block" %>
      <% end %>
    </div>

    <nav class="flex flex-wrap items-center gap-2 text-sm" aria-label="<%= t("app.nav.primary") %>">
      <% if public_context %>
        <% if conference %>
          <%= link_to t("public_conferences.sessions_title"), public_conference_path(conference), class: nav_link_class %>
        <% end %>
      <% else %>
        <%= link_to t("app.nav.conferences"), conferences_path, class: nav_link_class if authenticated? %>
        <% if current_user&.admin? %>
          <%= link_to t("app.nav.users"), admin_users_path, class: nav_link_class %>
        <% end %>
      <% end %>

      <div class="flex min-h-11 items-center gap-1 rounded-md border border-zinc-200 bg-white px-2 py-1 dark:border-zinc-800/80 dark:bg-zinc-900/70">
        <span class="text-xs text-zinc-600 dark:text-zinc-400"><%= t("app.nav.language") %></span>
        <%= link_to "JA", url_for(request.query_parameters.merge(locale: :ja)), class: "text-xs font-semibold #{current_locale == :ja ? "text-emerald-600 dark:text-emerald-300" : "text-zinc-600 dark:text-zinc-400"}" %>
        <span class="text-zinc-700 dark:text-zinc-300">/</span>
        <%= link_to "EN", url_for(request.query_parameters.merge(locale: :en)), class: "text-xs font-semibold #{current_locale == :en ? "text-emerald-600 dark:text-emerald-300" : "text-zinc-600 dark:text-zinc-400"}" %>
      </div>

      <%= render "shared/theme_toggle" %>

      <% unless public_context %>
        <% if authenticated? %>
          <span class="px-1 text-zinc-600 dark:text-zinc-400"><%= current_user.name %></span>
          <%= button_to t("app.nav.logout"), session_path, method: :delete, class: "min-h-11 rounded-md bg-zinc-100 px-3 py-2 font-medium text-zinc-950 transition-colors hover:bg-white" %>
        <% else %>
          <%= link_to t("app.nav.login"), new_session_path, class: nav_link_class %>
          <% if self_registration_enabled? %>
            <%= link_to t("app.nav.register"), new_registration_path, class: "inline-flex min-h-11 items-center rounded-md bg-zinc-100 px-3 py-2 font-medium text-zinc-950 transition-colors hover:bg-white" %>
          <% end %>
        <% end %>
      <% end %>
    </nav>
  </div>
</header>
