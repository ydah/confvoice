<%= form_with model: [:admin, user], class: "space-y-5" do |form| %>
  <%= render "shared/errors", resource: user %>

  <div>
    <%= form.label :name, "名前", class: "block text-sm font-medium text-zinc-700 dark:text-zinc-300" %>
    <%= form.text_field :name, required: true, class: "mt-2 w-full rounded-md border border-zinc-300 dark:border-zinc-700 px-3 py-2 focus:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-500" %>
  </div>

  <div>
    <%= form.label :email_address, "メールアドレス", class: "block text-sm font-medium text-zinc-700 dark:text-zinc-300" %>
    <%= form.email_field :email_address, required: true, class: "mt-2 w-full rounded-md border border-zinc-300 dark:border-zinc-700 px-3 py-2 focus:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-500" %>
  </div>

  <div>
    <%= form.label :role, "ロール", class: "block text-sm font-medium text-zinc-700 dark:text-zinc-300" %>
    <%= form.select :role, User.roles.keys.map { |role| [role, role] }, {}, class: "mt-2 w-full rounded-md border border-zinc-300 dark:border-zinc-700 px-3 py-2 focus:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-500" %>
  </div>

  <div class="grid gap-5 md:grid-cols-2">
    <div>
      <%= form.label :password, "パスワード", class: "block text-sm font-medium text-zinc-700 dark:text-zinc-300" %>
      <%= form.password_field :password, autocomplete: "new-password", class: "mt-2 w-full rounded-md border border-zinc-300 dark:border-zinc-700 px-3 py-2 focus:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-500" %>
    </div>
    <div>
      <%= form.label :password_confirmation, "パスワード確認", class: "block text-sm font-medium text-zinc-700 dark:text-zinc-300" %>
      <%= form.password_field :password_confirmation, autocomplete: "new-password", class: "mt-2 w-full rounded-md border border-zinc-300 dark:border-zinc-700 px-3 py-2 focus:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-500" %>
    </div>
  </div>

  <div class="flex flex-wrap gap-3">
    <%= form.submit "保存", class: "rounded-md bg-zinc-100 px-4 py-3 text-sm font-semibold text-zinc-950 hover:bg-white" %>
    <%= link_to "戻る", admin_users_path, class: "rounded-md border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-4 py-3 text-sm font-semibold text-zinc-900 dark:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800" %>
  </div>
<% end %>
